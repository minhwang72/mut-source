# monsil 배포용 얇은 층 — `~/mute/Dockerfile` 로 복사해 `~/mute-deploy.sh` 가 빌드한다.
FROM mute:base
# 장부용 드라이버. 순수 파이썬이라 빌드가 필요 없다.
RUN pip install --no-cache-dir PyMySQL==1.1.2
# **두 번째 판독기 homr** — 교차 검증용(tools/crosscheck.py).
# AGPL-3.0 (https://github.com/liebharc/homr). **수정하지 않고** 전용 가상환경에서
# 별도 프로세스로만 부른다(server/homr_runner.py). opencv-headless 등 의존성이
# 우리 쪽(ultralytics)과 섞이지 않게 분리한다. 모델은 빌드 때 받아 둔다(--init).
# 판독 모델은 Camera-PrIMuS(CC BY-NC)를 포함해 학습됐다 — 매출이 생기면
# PrIMuS 를 뺀 재학습으로 교체한다(homr LICENSE_FAQ.md).
RUN python -m venv /opt/homr \
 && /opt/homr/bin/pip install --no-cache-dir homr==0.7.0 \
 && /opt/homr/bin/homr --init
# **tools/ 도 올린다.** 판독 엔진이 전부 여기 있는데 base 이미지의 옛
# 사본이 쓰이고 있었다 — 10/2 조표 수정(keysigpos.py)이 라이브에 없었다.
# **검출 가중치도 올린다.** base 이미지의 omr.pt 는 펜·형광펜 없는 합성으로만
# 학습한 옛것이다(2026-10-21 교체: 펜 합성 6천 장 미세조정, 105장 통과 25 → 28).
COPY models/omr.pt /app/models/omr.pt
COPY tools/ /app/tools/
COPY server/ /app/server/
COPY web/ /app/web/
